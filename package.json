{
  "name": "lumanu-mcp-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server exposing business-oriented Lumanu payment tools over a swappable provider",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:types -- --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "harvest:contract": "tsx scripts/harvest-lumanu-contract.ts",
    "generate:types": "openapi-typescript docs/lumanu-reference/openapi.json --output src/generated/lumanu-api.ts --root-types --root-types-no-schema-prefix",
    "db:smoke": "tsx scripts/db/smoke-test.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.21.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
