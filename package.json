{
  "name": "lumanu-mcp-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server exposing business-oriented Lumanu payment tools over a swappable provider",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:types -- --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "harvest:contract": "tsx scripts/harvest-lumanu-contract.ts",
    "generate:types": "openapi-typescript docs/lumanu-reference/openapi.json --output src/generated/lumanu-api.ts --root-types --root-types-no-schema-prefix",
    "db:smoke": "tsx scripts/db/smoke-test.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "hasura:track": "tsx scripts/db/hasura-track.ts",
    "db:reset": "tsx scripts/db/drop.ts && npm run db:migrate && npm run db:seed && npm run hasura:track",
    "bundle": "tsx scripts/bundle.ts",
    "deploy": "tsx scripts/deploy.ts",
    "destroy": "aws cloudformation delete-stack --stack-name lumanu-mcp-poc-prod --region us-east-1"
  },
  "dependencies": {
    "@apollo/client": "^4.2.11",
    "@aws-sdk/client-ssm": "^3.1110.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/adm-zip": "^0.5.8",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.21.0",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
