# ─────────────────────────────────────────────────────────────
# Lumanu MCP POC — environment template
# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Provider selection ---------------------------------------
# mock  = MockLumanuProvider  → Apollo → Hasura Cloud v2 → Supabase
# real  = RealLumanuProvider  → Lumanu REST API (skeleton only, no credentials)
LUMANU_PROVIDER=mock

# --- Hasura Cloud v2 ------------------------------------------
# Project dashboard → GraphQL endpoint + admin secret
HASURA_GRAPHQL_ENDPOINT=https://<project>.hasura.app/v1/graphql
HASURA_ADMIN_SECRET=

# --- Supabase (PostgreSQL) ------------------------------------
# Local only. The scripts/db/* tools speak SQL, which Hasura does not
# expose; the deployed MCP server reaches the data through Hasura and
# never opens a socket here, so this never goes into SSM. See docs/10.
#
# Use the Supavisor SESSION-mode pooler on port 5432.
# NOT the direct db.<ref>.supabase.co host (IPv6-only), and NOT
# transaction mode on 6543 (breaks Hasura's prepared statements).
# Note the username format: postgres.<project-ref>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Auth0 (M2M, client_credentials) --------------------------
# Lambda needs only DOMAIN + AUDIENCE to validate JWTs via JWKS.
# CLIENT_ID/SECRET are for minting demo tokens for the reviewer.
AUTH0_DOMAIN=<tenant>.us.auth0.com
AUTH0_AUDIENCE=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- AWS ------------------------------------------------------
# Deploy target. Credentials resolved from the named profile —
# do not put access keys in this file.
AWS_REGION=us-east-1
AWS_PROFILE=

# --- Runtime --------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- Seed -----------------------------------------------------
# Fixed seed keeps canonical demo data byte-identical across
# local, CI, and deployed databases. Do not change casually —
# the README and example prompts reference these exact figures.
FAKER_SEED=713

# --- Lumanu API (RealLumanuProvider) --------------------------
# Read only when LUMANU_PROVIDER=real. Lumanu issues credentials on
# request — there is no self-serve signup — so this project has none
# and the provider stays an unexercised skeleton.
#
# BASE_URL is published in the harvested `servers` block: sandbox
# api.demo.lumanu.link, production api.lumanu.com. TOKEN_URL is NOT
# published anywhere in the fourteen harvested pages — Lumanu documents
# the client_credentials grant and the audience but not the endpoint —
# so it comes with the credentials rather than from the contract.
# LUMANU_API_BASE_URL=https://api.demo.lumanu.link/api/rest
# LUMANU_TOKEN_URL=
# LUMANU_CLIENT_ID=
# LUMANU_CLIENT_SECRET=
# LUMANU_AUDIENCE=https://lumanu-demo.hasura.app/v1/graphql
#
# Records the sandbox actually holds. With these four AND the four
# credentials above all set, the read half of the contract suite in
# tests/integration/real-provider.test.ts stops skipping and runs against
# Lumanu. The canonical Acme figures are this project's fixture, not
# Lumanu's, so nothing about a sandbox can be assumed — which is also why
# the write half stays skipped: it names the Acme records by id, and a
# sandbox cannot be reset between tests.
# LUMANU_WORKSPACE_ID=
# LUMANU_PROJECT_ID=
# LUMANU_PARTNER_ID=
# LUMANU_PAYABLE_ID=

# --- AWS runtime secrets -----------------------------------------------------
# Set only in Lambda. When present, four variables are read from SSM Parameter
# Store at container start, from SecureString parameters named after the
# variable they supply (e.g. <path>/HASURA_ADMIN_SECRET):
#   HASURA_GRAPHQL_ENDPOINT  HASURA_ADMIN_SECRET  AUTH0_DOMAIN  AUTH0_AUDIENCE
# SUPABASE_DB_URL is deliberately not among them. Anything already set in the
# environment wins, so a local .env is never overridden.
# Leave unset locally. See docs/adr/0003-ssm-parameter-store-rather-than-secrets-manager.md
SSM_PARAMETER_PATH=

# --- Connecting an MCP client to the deployed server -------------------------
# Read by the MCP *client*, not by this server. `.mcp.json.example` is the
# reference; copy it to `.mcp.json` — or let `claude mcp add --scope project`
# write it. Both name these two variables rather than holding their values, so
# neither the endpoint nor a token is ever committed.
#
#   claude mcp add --scope project --transport http lumanu \
#     '${LUMANU_MCP_URL}' \
#     --header 'Authorization: Bearer ${LUMANU_TOKEN}'
#
# Single quotes matter: they stop the shell expanding the variables and writing
# the real endpoint and token into a file that gets committed.
#
# IMPORTANT: both must be EXPORTED IN YOUR SHELL before Claude Code starts.
# Setting them in this file is not enough — `.mcp.json` is expanded from the
# process environment, and nothing loads `.env` on the client's behalf. Neither
# fails loudly when absent: the literal text `${LUMANU_MCP_URL}` is used as a
# URL, and `Bearer ${LUMANU_TOKEN}` is sent as a token, so a missing value looks
# like a wrong one.
#
#   PowerShell   $env:LUMANU_MCP_URL = 'https://<api-id>.execute-api.us-east-1.amazonaws.com/mcp'
#                $env:LUMANU_TOKEN   = (npm run --silent token)
#   Bash         export LUMANU_MCP_URL='https://<api-id>.execute-api.us-east-1.amazonaws.com/mcp'
#                export LUMANU_TOKEN=$(npm run --silent token)

# The deployed endpoint, printed by `npm run deploy` as a stack output. Kept
# here so it lives with the other per-machine values rather than in a committed
# file — but see the note above: it must still be exported before Claude Code
# starts, because the MCP client never reads this file.
LUMANU_MCP_URL=

# LUMANU_TOKEN is not set here. It is minted on demand by `npm run token` and
# lasts 24 hours, so a copy in this file would be stale more often than not.
